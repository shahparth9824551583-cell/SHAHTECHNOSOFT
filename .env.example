# Copy this file to .env.local and fill the values. NEVER commit .env.local.

# Firebase Web App config (Firebase Console > Project settings > Your apps > Web app). These are safe for the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (SERVER ONLY, secret). Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and keep the \n characters exactly as in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: public site URL
NEXT_PUBLIC_SITE_URL=https://shahtechnosoft.vercel.app
